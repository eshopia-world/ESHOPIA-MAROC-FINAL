# ════════════════════════════════════════
# E-SHOPIA MAROC — Environment Variables
# Copy this file to .env and fill values
# ════════════════════════════════════════

NODE_ENV=production
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/eshopia?retryWrites=true&w=majority

# JWT Secrets (generate with: openssl rand -hex 64)
JWT_SECRET=your_super_secret_jwt_key_min_64_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Admin credentials (for first setup)
ADMIN_EMAIL=admin@eshopia.ma
ADMIN_PASSWORD=ChangeMe@2024!

# Frontend URL (CORS)
FRONTEND_URL=https://eshopia.netlify.app

# WhatsApp Business API (Meta)
# Get from: https://developers.facebook.com/
WHATSAPP_TOKEN=your_whatsapp_business_api_token
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_BUSINESS_NUMBER=212XXXXXXXXX

# SMS (InTouch Maroc or Twilio)
SMS_PROVIDER=intouch
INTOUCH_LOGIN=your_intouch_login
INTOUCH_PASSWORD=your_intouch_password
INTOUCH_SENDER=E-SHOPIA

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ORDER_RATE_LIMIT_MAX=3

# Affiliate settings
AFFILIATE_COMMISSION_RATE=0.10
AFFILIATE_MIN_PAYOUT=200
AFFILIATE_COOKIE_DAYS=30

# Platform commission from vendors
MARKETPLACE_PLATFORM_FEE=0.15

# Delivery (free above this amount in DH)
FREE_DELIVERY_THRESHOLD=129
